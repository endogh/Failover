{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codenest-failover",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",                       // env.ASSETS dipakai di worker.js
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true                   // Worker jalan dulu, baru boleh ke assets
  },

  // Pakai routes (bukan custom_domain) karena DNS domain
  // masih menunjuk ke origin server kamu (harus Proxied / awan oranye)
    "routes": [
    { "pattern": "codenest.id/*",       "zone_name": "codenest.id" },
    { "pattern": "www.codenest.id/*",   "zone_name": "codenest.id" },
    { "pattern": "log.codenest.id/*",   "zone_name": "codenest.id" },
    { "pattern": "api.codenest.id/*",   "zone_name": "codenest.id" },
    { "pattern": "quran.codenest.id/*", "zone_name": "codenest.id" }
  ],

  "vars": {
    "SITE_NAME": "Codenest",
    "ORIGIN_TIMEOUT_MS": "8000",
    "DEBUG": "true"
  },

  "observability": { "enabled": true }
}
